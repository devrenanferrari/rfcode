{
  "name": "rfcode",
  "displayName": "rfcode — agente de IA grátis (NVIDIA)",
  "description": "Agente de IA gratuito com modelos da NVIDIA: edita código, roda testes, cria PowerPoint, Word e vídeos narrados, navega na web, controla o PC e funciona pelo celular.",
  "version": "1.8.0",
  "publisher": "renan",
  "license": "MIT",
  "icon": "media/logo.png",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=18"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ai",
    "agent",
    "coding agent",
    "nvidia",
    "nemotron",
    "free",
    "gratis",
    "chat",
    "copilot",
    "claude code",
    "powerpoint",
    "pptx",
    "video",
    "automation",
    "portugues"
  ],
  "main": "./extension/extension.js",
  "bin": {
    "rfcode": "bin/rfcode.js"
  },
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rfcode",
          "title": "rfcode",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "rfcode": [
        {
          "type": "webview",
          "id": "rfcode.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "rfcode.open",
        "title": "rfcode: Abrir chat"
      },
      {
        "command": "rfcode.newChat",
        "title": "rfcode: Nova conversa",
        "icon": "$(add)"
      },
      {
        "command": "rfcode.setApiKey",
        "title": "rfcode: Configurar API key da NVIDIA"
      },
      {
        "command": "rfcode.openTerminal",
        "title": "rfcode: Abrir no terminal"
      },
      {
        "command": "rfcode.askSelection",
        "title": "rfcode: Perguntar sobre a seleção"
      },
      {
        "command": "rfcode.selfImprove",
        "title": "rfcode (dev): Auto-melhoria (loop do SDD)"
      },
      {
        "command": "rfcode.dashboard",
        "title": "rfcode (dev): Painel de auto-melhoria"
      },
      {
        "command": "rfcode.history",
        "title": "rfcode: Histórico de conversas",
        "icon": "$(history)"
      },
      {
        "command": "rfcode.remote",
        "title": "rfcode: Controle remoto pelo celular",
        "icon": "$(device-mobile)"
      },
      {
        "command": "rfcode.remoteStop",
        "title": "rfcode: Desligar controle remoto"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "rfcode.askSelection",
          "when": "editorHasSelection",
          "group": "navigation@99"
        }
      ],
      "view/title": [
        {
          "command": "rfcode.newChat",
          "when": "view == rfcode.chat",
          "group": "navigation@1"
        },
        {
          "command": "rfcode.history",
          "when": "view == rfcode.chat",
          "group": "navigation@2"
        },
        {
          "command": "rfcode.remote",
          "when": "view == rfcode.chat",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "rfcode.selfImprove",
          "when": "config.rfcode.developerMode"
        },
        {
          "command": "rfcode.dashboard",
          "when": "config.rfcode.developerMode"
        }
      ]
    },
    "configuration": {
      "title": "rfcode",
      "properties": {
        "rfcode.model": {
          "type": "string",
          "default": "nvidia/nemotron-3-super-120b-a12b",
          "description": "Modelo da NVIDIA (build.nvidia.com) usado pelo agente. Precisa suportar tool calling."
        },
        "rfcode.autoApprove": {
          "type": "boolean",
          "default": false,
          "description": "Executar edições, comandos e controle do PC sem pedir confirmação."
        },
        "rfcode.repoPath": {
          "type": "string",
          "default": "",
          "description": "(Desenvolvimento) Clone do repositório do rfcode usado pela auto-melhoria. Só vale com rfcode.developerMode ligado."
        },
        "rfcode.remotePort": {
          "type": "number",
          "default": 7433,
          "minimum": 1,
          "maximum": 65535,
          "description": "Porta do controle remoto pelo celular. Se estiver ocupada, o rfcode usa outra livre."
        },
        "rfcode.developerMode": {
          "type": "boolean",
          "default": false,
          "description": "Mostra os comandos de desenvolvimento do próprio rfcode (auto-melhoria e painel do SDD)."
        }
      }
    }
  },
  "type": "commonjs",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "self-improve": "node scripts/self-improve.js",
    "painel": "node scripts/dashboard.js --open"
  },
  "pricing": "Free",
  "galleryBanner": {
    "color": "#0F1115",
    "theme": "dark"
  }
}
