{
  "name": "rfcode",
  "displayName": "rfcode",
  "description": "Agente de IA para VS Code com os modelos gratuitos de build.nvidia.com. Edita código, executa testes, pesquisa na web, gera documentos e vídeos e automatiza tarefas no Windows.",
  "version": "1.14.1",
  "publisher": "renanferrari",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/devrenanferrari/rfcode.git"
  },
  "homepage": "https://github.com/devrenanferrari/rfcode#readme",
  "bugs": {
    "url": "https://github.com/devrenanferrari/rfcode/issues"
  },
  "icon": "media/logo.png",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=18"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ai",
    "agent",
    "coding agent",
    "assistente",
    "nvidia nim",
    "nemotron",
    "free",
    "gratis",
    "chat",
    "powerpoint",
    "pptx",
    "video",
    "automation",
    "portugues",
    "brasil"
  ],
  "main": "./extension/extension.js",
  "bin": {
    "rfcode": "bin/rfcode.js"
  },
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rfcode",
          "title": "rfcode",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "rfcode": [
        {
          "type": "webview",
          "id": "rfcode.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "rfcode.open",
        "title": "Abrir chat",
        "category": "rfcode"
      },
      {
        "command": "rfcode.newChat",
        "title": "Nova conversa",
        "icon": "$(add)",
        "category": "rfcode"
      },
      {
        "command": "rfcode.setApiKey",
        "title": "Configurar API key da NVIDIA",
        "category": "rfcode"
      },
      {
        "command": "rfcode.openTerminal",
        "title": "Abrir no terminal",
        "category": "rfcode"
      },
      {
        "command": "rfcode.askSelection",
        "title": "Perguntar sobre a seleção",
        "category": "rfcode"
      },
      {
        "command": "rfcode.selfImprove",
        "title": "Auto-melhoria (SDD)",
        "category": "rfcode (desenvolvimento)"
      },
      {
        "command": "rfcode.dashboard",
        "title": "Painel de auto-melhoria",
        "category": "rfcode (desenvolvimento)"
      },
      {
        "command": "rfcode.history",
        "title": "Histórico de conversas",
        "icon": "$(history)",
        "category": "rfcode"
      },
      {
        "command": "rfcode.remote",
        "title": "Controle remoto",
        "icon": "$(device-mobile)",
        "category": "rfcode"
      },
      {
        "command": "rfcode.remoteStop",
        "title": "Desligar controle remoto",
        "category": "rfcode"
      },
      {
        "command": "rfcode.setProvider",
        "title": "Configurar provedor de modelos",
        "category": "rfcode"
      },
      {
        "command": "rfcode.doctor",
        "title": "Verificar ambiente (doctor)",
        "category": "rfcode"
      },
      {
        "command": "rfcode.openLog",
        "title": "Abrir log de erros",
        "category": "rfcode"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "rfcode.askSelection",
          "when": "editorHasSelection",
          "group": "navigation@99"
        }
      ],
      "view/title": [
        {
          "command": "rfcode.newChat",
          "when": "view == rfcode.chat",
          "group": "navigation@1"
        },
        {
          "command": "rfcode.history",
          "when": "view == rfcode.chat",
          "group": "navigation@2"
        },
        {
          "command": "rfcode.remote",
          "when": "view == rfcode.chat",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "rfcode.selfImprove",
          "when": "config.rfcode.developerMode"
        },
        {
          "command": "rfcode.dashboard",
          "when": "config.rfcode.developerMode"
        }
      ]
    },
    "configuration": {
      "title": "rfcode",
      "properties": {
        "rfcode.model": {
          "type": "string",
          "default": "nvidia/nemotron-3-super-120b-a12b",
          "description": "Modelo usado pelo agente. Para outros provedores, use o prefixo do provedor (ex.: groq:llama-3.3-70b-versatile, ollama:qwen3:8b). O modelo precisa suportar chamadas de ferramenta."
        },
        "rfcode.autoApprove": {
          "type": "boolean",
          "default": false,
          "description": "Executa edições, comandos e ações no sistema sem pedir aprovação."
        },
        "rfcode.repoPath": {
          "type": "string",
          "default": "",
          "description": "Repositório do rfcode usado pela auto-melhoria. Válido apenas com rfcode.developerMode ativado."
        },
        "rfcode.remotePort": {
          "type": "number",
          "default": 7433,
          "minimum": 1,
          "maximum": 65535,
          "description": "Porta do controle remoto. Se estiver em uso, outra porta livre é escolhida."
        },
        "rfcode.developerMode": {
          "type": "boolean",
          "default": false,
          "description": "Exibe os comandos de desenvolvimento do rfcode."
        }
      }
    }
  },
  "type": "commonjs",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "self-improve": "node scripts/self-improve.js",
    "painel": "node scripts/dashboard.js --open"
  },
  "pricing": "Free",
  "galleryBanner": {
    "color": "#0F1115",
    "theme": "dark"
  }
}
